{
  "name": "status-list-server-1",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.2.2",
      "zod": "^4.1.13",
      "typescript": "^5",
      "@types/bun": "^1.3.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "check-types": "bun run --filter '*' check-types",
    "db:studio": "bun run --filter @status-list-server/db db:studio",
    "db:generate": "bun run --filter @status-list-server/db db:generate",
    "db:migrate": "bun run --filter @status-list-server/db db:migrate",
    "style:check": "biome check .",
    "style:fix": "biome check --write ."
  },
  "dependencies": {
    "@status-list-server/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@status-list-server/config": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.2"
}
