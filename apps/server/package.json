{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@sd-jwt/jwt-status-list": "^0.19.0",
    "@status-list-server/db": "workspace:*",
    "@status-list-server/env": "workspace:*",
    "dotenv": "catalog:",
    "hono": "^4.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@status-list-server/config": "workspace:*",
    "@types/bun": "catalog:",
    "@vitest/coverage-v8": "^4.1.4",
    "tsdown": "^0.16.5",
    "typescript": "catalog:",
    "vitest": "^4.1.4"
  }
}
